# Copy to .env; set a fresh random admin key of at least 32 characters.
FOUNDIT_DATABASE_URL=postgresql://foundit:foundit@localhost:5432/foundit
FOUNDIT_ADMIN_KEY=replace-with-a-random-key-at-least-32-characters
FOUNDIT_POOL_SIZE=10
FOUNDIT_DEFAULT_PAGE_SIZE=20
FOUNDIT_MAX_PAGE_SIZE=100
FOUNDIT_MATCH_WINDOW_DAYS=30
FOUNDIT_UPLOAD_DIR=uploads
FOUNDIT_MAX_PHOTO_BYTES=5242880
FOUNDIT_CORS_ORIGINS=["http://localhost:5173"]
